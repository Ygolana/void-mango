{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": [
    	"ext/workspaces"
    	//"mango/layout",
    	//"mango/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "wireplumber",
        "network",
        "battery",
        "tray"
    ],
    "ext/workspaces": {
    	"format": "{icon}",
	"format-icons": {
        "1": "一",
        "2": "二",
        "3": "三",
        "4": "四",
        "5": "五",
        "6": "六",
        "7": "七",
        "8": "八",
        "9": "九",
        "10": "十",
        "11": "十一",
        "12": "十二",
        "13": "十三",
        "14": "十四",
        "15": "十五",
        "16": "十六",
        "17": "十七",
        "18": "十八",
        "19": "十九",
        "20": "二十",
        "default": "・"
    },
    	"hide-empty": true,
    	"on-click": "activate",
    	"on-click-right": "toggle",
    	"overview-label": "OVERVIEW"
    },
    "mango/layout": {
    	"format": "{}"
    // "format-S": "Scroller",
    // "format-T": "Tile",
    },
    "mango/window": {
    	"format": "{}",
    	"icon-size": 20
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["  ", "  ", "  ", "  ", "  "]
    },
    "network": {
        "format-wifi": "{signalStrength}  ",
        "format-disconnected": "Disconnected  "
    },
    "wireplumber": {
        "format": "{volume}% {icon}",
        "format-muted": "Muted  ",
        "format-icons": {
            "default": [" ", " ", " "]    }
    }
}
